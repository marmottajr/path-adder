{
  "name": "path-adder-extension",
  "displayName": "Path Adder",
  "description": "Add file path comments to JavaScript and TypeScript files",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pathAdder.addPathsToWorkspace",
        "title": "Add Path Comments to All JS/TS Files",
        "category": "Path Adder"
      },
      {
        "command": "pathAdder.addPathToCurrentFile",
        "title": "Add Path Comment to Current File",
        "category": "Path Adder"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "pathAdder.addPathsToWorkspace",
          "when": "explorerResourceIsFolder",
          "group": "pathAdder"
        }
      ],
      "editor/context": [
        {
          "command": "pathAdder.addPathToCurrentFile",
          "when": "resourceExtname == .js || resourceExtname == .ts",
          "group": "pathAdder"
        }
      ],
      "commandPalette": [
        {
          "command": "pathAdder.addPathsToWorkspace"
        },
        {
          "command": "pathAdder.addPathToCurrentFile",
          "when": "resourceExtname == .js || resourceExtname == .ts"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "20.x",
    "typescript": "^5.4.5"
  }
}
